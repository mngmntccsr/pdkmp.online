# Copia questo file in ".env" per i test in locale (NON committare il .env vero!)
# In GitHub Actions, questi stessi nomi vanno inseriti come "Repository Secrets".

# Server SMTP per l'invio dell'email (esempio con Gmail: smtp.gmail.com / 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuoindirizzo@gmail.com
# Con Gmail serve una "App Password" (non la password normale del tuo account)
SMTP_PASS=xxxxxxxxxxxxxxxx

# Mittente e destinatario dell'email
EMAIL_FROM=tuoindirizzo@gmail.com
EMAIL_TO=tuoindirizzo@gmail.com

# Se "true", invia sempre l'email settimanale anche se non ci sono variazioni.
# Se "false", invia l'email SOLO quando ci sono eventi aggiunti/rimossi.
ALWAYS_SEND=true
